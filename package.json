{
  "name": "plium",
  "version": "0.4.0-plium.8",
  "description": "PLIUM / 叠间 - an edge clipboard shelf for Windows",
  "author": "PLIUM contributors",
  "license": "Apache-2.0",
  "private": true,
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:github": "npm run build && electron-builder --win nsis -c.extraMetadata.buildTarget=github",
    "build:store": "node -e \"console.error('PLIUM MSIX preview distribution is disabled');process.exit(1)\"",
    "build:msix": "node -e \"console.error('PLIUM MSIX preview distribution is disabled');process.exit(1)\"",
    "build:win": "npm run build:github",
    "package": "npm run build:github",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run",
    "postinstall": "install-electron"
  },
  "build": {
    "appId": "com.ardss.plium",
    "productName": "PLIUM",
    "directories": {
      "output": "dist",
      "buildResources": "resources"
    },
    "files": [
      "out/**/*",
      "!out/renderer/**/*.gif",
      "!out/ts/**",
      "resources/**/*",
      "!resources/startup/**/*.exe",
      "!resources/startup/**/*.cs",
      "!resources/appx/**",
      "package.json",
      "!**/node_modules/emoji-datasource-twitter/**",
      "!**/node_modules/gsap/**",
      "!**/node_modules/framer-motion/**",
      "!**/node_modules/@fontsource/**",
      "!**/node_modules/@radix-ui/**",
      "!**/node_modules/svg-path-bbox/**",
      "!**/node_modules/react-dom/**",
      "!**/node_modules/prism-react-renderer/**",
      "!**/node_modules/koffi/doc/**"
    ],
    "extraResources": [
      {
        "from": "node_modules/emoji-datasource-twitter/img/twitter/64",
        "to": "emoji/64"
      }
    ],
    "asarUnpack": [
      "**/*.{node,dll}",
      "**/node_modules/koffi/**/*",
      "**/node_modules/@koromix/**/*",
      "**/node_modules/@resvg/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "PLIUM 叠间",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "PLIUM-Setup-${version}.${ext}"
    }
  },
  "devDependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@radix-ui/react-scroll-area": "^1.2.13",
    "@radix-ui/react-separator": "^1.1.11",
    "@types/node": "^24.19.2",
    "@types/react": "^18.2.73",
    "@types/react-dom": "^18.2.22",
    "@vitalets/google-translate-api": "^9.2.1",
    "@vitejs/plugin-react": "^4.2.1",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.1",
    "electron-vite": "^6.0.0",
    "emoji-datasource-twitter": "^16.0.0",
    "framer-motion": "^11.0.24",
    "gsap": "^3.15.0",
    "prism-react-renderer": "^2.4.1",
    "react-dom": "^18.2.0",
    "svg-path-bbox": "^2.1.0",
    "typescript": "^5.4.3",
    "vite": "^8.3.6",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "electron-updater": "^6.8.9",
    "koffi": "^3.1.2",
    "react": "^18.2.0",
    "zustand": "^4.5.2"
  }
}
